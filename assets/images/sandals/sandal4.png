enefits":["Free returns","CHF5.00 Credit for delay","Return if item damaged","15-day no update refund","30-day no delivery refund","Price adjustment"],"benefitsV2":[{"text":"Free returns","type":1},{"text":"CHF5.00 Credit for delay","type":1},{"text":"Return if item damaged","type":1},{"text":"15-day no update refund","type":1},{"text":"30-day no delivery refund","type":1},{"text":"Price adjustment","type":1}],"benefitsV3":[{"textRich":[{"type":0,"verAlign":0,"value":"Free returns","fontSize":12,"fontColor":"#FFFFFF","fontWeight":500,"id":1}],"bgColor":"#0B8000","corner":3,"paddingStart":4,"paddingEnd":4,"maxLine":1,"supportPromotion":false},{"textRich":[{"type":0,"verAlign":0,"value":"CHF5.00 Credit for delay","fontSize":12,"fontColor":"#FFFFFF","fontWeight":500,"id":1}],"bgColor":"#0B8000","corner":3,"paddingStart":4,"paddingEnd":4,"maxLine":1,"supportPromotion":false},{"textRich":[{"type":0,"verAlign":0,"value":"Return if item damaged","fontSize":12,"fontColor":"#FFFFFF","fontWeight":500,"id":1}],"bgColor":"#0B8000","corner":3,"paddingStart":4,"paddingEnd":4,"maxLine":1,"supportPromotion":false},{"textRich":[{"type":0,"verAlign":0,"value":"15-day no update refund","fontSize":12,"fontColor":"#FFFFFF","fontWeight":500,"id":1}],"bgColor":"#0B8000","corner":3,"paddingStart":4,"paddingEnd":4,"maxLine":1,"supportPromotion":false},{"textRich":[{"type":0,"verAlign":0,"value":"30-day no delivery refund","fontSize":12,"fontColor":"#FFFFFF","fontWeight":500,"id":1}],"bgColor":"#0B8000","corner":3,"paddingStart":4,"paddingEnd":4,"maxLine":1,"supportPromotion":false},{"textRich":[{"type":0,"verAlign":0,"value":"Price adjustment","fontSize":12,"fontColor":"#FFFFFF","fontWeight":500,"id":1}],"bgColor":"#0B8000","corner":3,"paddingStart":4,"paddingEnd":4,"maxLine":1,"supportPromotion":false}]},"orderGuaranteeFloating":{"guaranteeItems":[{"title":"Free returns within 90 days of purchase","benefits":["The first return of one or multiple returnable items for EVERY order is free!","This item can be returned within 90 days from the date of purchase.","If the returned item is used or damaged, or has missing parts\u002Faccessories, and this is not due to Temu or the seller, the refund will be reduced to compensate for the lost value of the item."],"jumpText":"For more exceptions and details about the policy, please refer to our policy page","jumpUrl":"\u002Freturn-and-refund-policy.html"},{"title":"CHF5.00 Credit for delay","benefits":["If your order isn't delivered on or before the latest delivery date provided to you, we will offer you a CHF5.00 credit (Standard Shipping), a CHF5.00 credit (Click & Collect), or a CHF7.00 credit (Express Shipping) within approximately 48 hours of that date as a gesture of courtesy. The credit will be issued to your Temu credit balance and can be used on your next order.\nUnder specific circumstances, including but not limited to natural disasters and other unforeseeable circumstances, you may not be able to receive compensation for late delivery."],"jumpText":"For more exceptions and details about the policy, please refer to our policy page","jumpUrl":"\u002Flate-delivery-compensation-policy.html"},{"title":"Return if item damaged","benefits":["If you receive your package and find that some items are lost or damaged in transit, rest assured that you can easily apply for a full refund for those items. "]},{"title":"15-day no update refund","benefits":["If your package has no tracking updates for over 15 days and has not been delivered, you can request a free reshipment or refund because the package may have been lost in transit. If you receive the package after your request has been approved, you may be allowed to keep it for free in certain circumstances without needing to return it.\nIn certain circumstances, including but not limited to natural disasters and other force majeure circumstances, you may not be able to receive compensation or request a refund if there have not been updates. Eligibility timeframes may vary depending on the shipping method, order type, and other order details. After placing an order, please refer to the delivery guarantee on the order details page for the applicable timeframe."],"jumpText":"For more exceptions and details about the policy, please refer to our policy page","jumpUrl":"\u002Fpackage-lost-compensation-policy.html"},{"title":"30-day no delivery refund","benefits":["If your package isn't delivered within 30 days after shipment (5 days more for packages shipped via truck or packages weighing 80 kg or more), you can request a free reshipment or refund. If you receive the package after your request has been approved, you may be allowed to keep it for free in certain circumstances without needing to return it.\nIn certain circumstances, including but not limited to natural disasters and other force majeure circumstances, you may not be able to request a free reshipment or a refund if your order wasn't delivered. Eligibility timeframes may vary depending on the shipping method, order type, and other order details. After placing an order, please refer to the delivery guarantee on the order details page for the applicable timeframe."],"jumpText":"For more exceptions and details about the policy, please refer to our policy page","jumpUrl":"\u002Fno-delivery-compensation-policy.html"},{"title":"Price adjustment within 30 days of payment","benefits":["Items purchased from Temu are eligible for our price adjustment policy. Temu will provide the price difference in the currency that the order was paid in if the selling price of the item purchased was reduced within 30 days of payment in the same country or region. The shipment of your order will not be affected by applying for a price adjustment before you receive your item(s). You can request a price adjustment refund by selecting the relevant order in 'Your Orders' and clicking on the 'Price adjustment' button.","Items that are promotional or no longer available may not be eligible for our price adjustment policy. Fees, including but not limited to shipping fees, will be excluded for any price adjustment calculation. Temu reserves the right to the final interpretation of our price adjustment policy, the right to modify the terms of this policy at any time, and the right to deny any price adjustment at our sole discretion."]}]},"paymentPrivacyGuarantee":{"iconUrl":"https:\u002F\u002Faimg.kwcdn.com\u002Fupload_aimg_b\u002Ftrade_design\u002Fce890bb5-6278-47e0-beb4-b89afc0b661f.png.slim.png","titleColor":"#000000","linkUrl":"\u002Fwhychoosetemu.html?target=security","benefits":["Safe payments","Secure privacy"]}},"showModule":1},"belowTitleModule":{"moduleId":"below_title_module","data":{},"showModule":1},"categoryRecModule":{"moduleId":"category_rec_module","data":{},"showModule":1},"recentlyViewedModule":{"moduleId":"recently_viewed_module","showModule":0},"sourceInfoModule":{"moduleId":"source_info_module","data":{},"showModule":1},"customerServiceModule":{"moduleId":"customer_service_module","data":{"hidRn":"_299","track":{"error_code":"_299","response_mall_id":634418217634125}},"showModule":1},"productDetailExtensionModule":{"moduleId":"product_detail_extension_module","data":{"goodsPropertyExtendText":{"seeDetails":"See all details","seeDetailsDimensions":"See all details and dimensions"},"brandImage":{"brandType":1,"brandHeader":"100% Authentic","brandName":"Brand Official Store: ZPLXQQ","bgUrl":"https:\u002F\u002Faimg.kwcdn.com\u002Fupload_aimg\u002Fpho\u002F5bbb5092-02f0-41df-a473-4f475a1173c5.jpg","middleUrl":"https:\u002F\u002Faimg.kwcdn.com\u002Fupload_aimg\u002Faftersales\u002Fb2d7ec1e-9051-4764-9fb9-2c73920d41a6.png","iconUrl":"https:\u002F\u002Faimg.kwcdn.com\u002Fupload_aimg\u002Faftersales\u002F0f257800-3b95-405c-b486-bfcd2656d255.png","flowerUrl":"https:\u002F\u002Faimg.kwcdn.com\u002Fupload_aimg\u002Faftersales\u002Faa090206-fa4d-44ce-b0af-5b605a9cc3d8.png","pcThumbUrl":"https:\u002F\u002Faimg.kwcdn.com\u002Fupload_aimg\u002Faftersales\u0
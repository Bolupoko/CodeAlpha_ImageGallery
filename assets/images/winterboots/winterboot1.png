2:62870","name":"Mid Heel","groupIdx":11},"P3672:62869":{"filter":"P3672:62869","name":"Low Heel","groupIdx":11},"P3672:62871":{"filter":"P3672:62871","name":"High Heel","groupIdx":11},"P3672:62872":{"filter":"P3672:62872","name":"Ultrahigh Heel","groupIdx":11},"P203:586692":{"filter":"P203:586692","name":"Summer","groupIdx":12},"P203:2827":{"filter":"P203:2827","name":"All-season","groupIdx":12},"P203:733512":{"filter":"P203:733512","name":"Four Seasons","groupIdx":12},"P203:634789":{"filter":"P203:634789","name":"Spring","groupIdx":12},"P203:32561":{"filter":"P203:32561","name":"Spring\u002FSummer","groupIdx":12},"P203:639":{"filter":"P203:639","name":"Fall","groupIdx":12},"P203:2729":{"filter":"P203:2729","name":"All Seasons","groupIdx":12},"300:4":{"filter":"300:4","name":"& up","mallStar":4,"groupIdx":13},"300:3":{"filter":"300:3","name":"& up","mallStar":3,"groupIdx":13},"300:2":{"filter":"300:2","name":"& up","mallStar":2,"groupIdx":13},"104:-1,5":{"filter":"104:-1,5","maxPrice":"5","name":"Under CHF5","groupIdx":14},"104:5,10":{"filter":"104:5,10","maxPrice":"10","minPrice":"5","name":"CHF5 - CHF10","groupIdx":14},"104:10,15":{"filter":"104:10,15","maxPrice":"15","minPrice":"10","name":"CHF10 - CHF15","groupIdx":14},"104:15,-1":{"filter":"104:15,-1","minPrice":"15","name":"Over CHF15","groupIdx":14},"104:":{"filter":"104:","input":["CHF","Min.","to","CHF","Max."],"groupIdx":14},"404:-1":{"filter":"404:-1","name":"Temu","groupIdx":15}},"curFilterGroupActiveTabIdx":-1,"activeFilterGroupInfo":null,"showLineMap":{},"filterTags":[],"selectText":[],"explainInfo":{"buttonText":"OK","text":"We use various factors for recommending products to you. The importance or weighting of a factor may change over time. When you use the search engine on Temu, search results are ranked by default according to their “Relevance”.\n\nThe following factors are generally considered more significant than others in determining which product will be of most relevance to you:\n\n •  The relevance of product listings to your search keywords;\n •  Your browsing, searching and purchasing history on Temu;\n •  Time you spent viewing specific product listings on Temu.\n\nThe following factors can also influence how products are recommended on Temu:\n\n •  Your account profile (such as your country\u002Fregion if recorded in your account profile);\n •  Your approximate location based on your technical information (e.g. IP address);\n •  The popularity of products on Temu;\n •  Current deals campaigns; and\n •  Product prices.\n\nProduct ranking is also influenced by the price paid by sellers to Temu to receive a higher ranking for a specific offer. Where applicable, these offers appear with the label \"AD\" and are ranked higher than offers that have not been paid for. Thus, when displaying offers with similar relevance, we may show offers that have been paid for in the search results page before offers that have not been paid for.\n\nThe products that we recommend changes over time in accordance with the above criteria. For example, the content we recommend will change based on your purchase of different products, browsing for new products and similar activities by other users.\n\nYou can also change the layout of product listings by selecting one of the following alternative sorting criteria:\n\n •  Best sellers\n •  Most Recent\n •  Price low to high\n •  Price high to low\n\nRegardless of the sorting option selected, you can also refine your search by filtering the results based on features of the products, such as colour, review ratings, price and specific product details.","title":"Learn more about these results","innerTitle":"Product Ranking on the Result Page"},"scene":"search","filterItems":"","cacheOptions":{"enable":true,"hasHistoryListener":false},"filterRegionPSearch":"{\"aar\":\"1\",\"list_id\":\"0d92c451fc8447778e42151206a9d03d\",\"xgw_reqid\":\"1795620127459-1e6f2a7b4e312087bb661201a2134cc2d6\",\"p_log_id\":\"9e01feb3014842bbbfa9c2f0a5b32faa\"}"},"searchEventInfo":{"op":"event","sub_op":"search","query":"sandals for women","p_search":"{\"aar\":\"1\",\"list_id\":\"0d92c451fc8447778e42151206a9d03d\",\"xgw_reqid\":\"1795620127459-1e6f2a7b4e312087bb661201a2134cc2d6\",\"p_log_id\":\"20f5263484e44e23b290f6eeb0d2dee4\"}","is_nres":0,"list_id":"0d92c451fc8447778e42151206a9d03d","is_banner":0,"srch_page_type":"search_result","srch_enter_source":"top_search_entrance_10032","srch_scene_type":"main","search_method":"suggest"},"realSearchKey":"","isLogin":false,"usePrefetchGoods":true,"fsGoodsCount":14,"userRegion":{},"isNativePlatform":false,"isIOSSystem":false},"chromeAiPromptConfigB":"NznPjM+Y","chromeAiPromptConfigA":"JTg0zrUl"};document.dispatchEvent(new Event('XRenderInitialPropsLoaded'));</script><script>window.__InitialLanguage__='en';
        window.__InitialI18nStore__={"en":{"search_result":{"noResultFor":"No results for \"{0}\"","noSearchTrySearch":"No results for \"{0}\", try searching:","buyAgain":"Buy again","noResultExplain":"Search results are updated in real time based on inventory levels and the regional market situation. If you can't find a particular item, there may be several reasons, such as the item being out of stock or it not currently being available in your region.","noItems":{"title":"Oops! The items are gone.","desc":"Try again to find items","button":"Try again"},"search":"Search","recTitle":"Our picks for you","waistRec":{"title":"Related searches","suggestTitle":"Suggested searches"},"listEndText":"No more results","sortInfo":{"text":"Learn more about these results","popupTitle":"Product Ranking on the Result Page","popupText":"We use various factors for recommending products to you. The importance or weighting of a factor may change over time. When you use the search engine on Temu, search results are ranked by default according to their “Relevance”.\n\nThe following factors are generally considered more significant than others in determining which product will be of most relevance to you:\n\n •  The relevance of product listings to your search keywords;\n •  Your browsing, searching and purchasing history on Temu;\n •  Time you spent viewing specific product listings on Temu.\n\nThe following factors can also influence how products are recommended on Temu:\n\n •  Your account profile (such as your country/region if recorded in your account profile);\n •  Your approximate location based on your technical information (e.g. IP address);\n •  The popularity of products on Temu;\n •  Current deals campaigns; and\n •  Product prices.\n\nProduct ranking is also influenced by the price paid by sellers to Temu to receive a higher ranking for a specific offer. Where applicable, these offers appear with the label \"AD\" and are ranked higher than offers that have not been paid for. Thus, when displaying offers with similar relevance, we may show offers that have been paid for in the search results page before offers that have not been paid for.\n\nThe products that we recommend changes over time in accordance with the above criteria. For example, the content we recommend will change based on your purchase of different products, browsing for new products and similar activities by other users.\n\nYou can also change the layout of product listings by selecting one of the following alternative sorting criteria:\n\n •  Best sellers\n •  Most Recent\n •  Price low to high\n •  Price high to low\n\nRegardless of the sorting option selected, you can also refine your search by filtering the results based on features of the products, such as colour, review ratings, price and specific product details.","ok":"OK"}},"global":{"openNewTab":"Open in new tab.","breadCrumb.Home":"Home","breadCrumb.TreeLanding":"Temu's Tree Planting Program","explainIcon":"explanation","rate":"{0} out of five stars","itemPicture":"item picture","energyTag":"Energy label information","splide":{"next":"Next slide","prev":"Previous slide"},"seeAll":"See all","seeMore":"See more","home":"Home","emptyTitle":"It is empty","endsIn":"Ends in","regularPricePrefix":"Reg.","defaultPageTitle":"Temu | Shop for Electronic, Women's Clothing, Men's Clothing, Fashion...","on":"on","viewAll":"View all","SimilarGoodsTitle":"Similar items","seoComponents":{"endsIn":"Ends in","viewMore":"View more","reductionOff":"{{reduction}}% off","outlets":" Outlets","outletTags":"Select items on outlets"},"RegionSelector":{"title":"Ship to","subContent":"Delivery options may vary for differernt locations","addText":"Ship to other location"},"ShoppingBar":{"buy":"Buy Now","addCart":"Add to Cart","AddSuccessPopup":{"addCart":"Added to Cart","goCart":"Go to Cart","recTitle":"Frequently bought together","noMoreGoods":"No More Goods"}},"time":"{{val, datetime}}","review":{"title":"Reviews"},"recommend":{"title":"R